{
  "manifest_version": 3,
  "name": "GitHub Image Preview",
  "version": "1.0.0",
  "description": "点击 GitHub 上的图片即可原地预览，支持缩放、下载与多图切换。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GitHub Image Preview"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://*.github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-image-preview@example.com",
      "strict_min_version": "115.0"
    }
  }
}
